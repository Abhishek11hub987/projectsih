# ══════════════════════════════════════════════════════════════════
#  SETU — SIH26043 Portal · Environment Variables Template
#  Copy this file to `.env` and populate the values before running.
# ══════════════════════════════════════════════════════════════════

# ─── 1. SUPABASE (REQUIRED — the database, auth, file storage) ────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ─── 2. GROQ — LLM CLASSIFICATION (optional) ─────────────────────
# console.groq.com → API Keys (free tier available)
# If empty, the app falls back to the built-in keyword classification engine.
GROQ_API_KEY=

# ─── 3. GOOGLE GEMINI — EMBEDDINGS (optional) ─────────────────────
# aistudio.google.com → Get API Key (free tier available)
# If empty, dedup falls back to the built-in token-similarity engine.
GEMINI_API_KEY=

# ─── 4. RESEND — TRANSACTIONAL EMAIL (optional) ───────────────────
# resend.com → API Keys (100 free emails/day)
RESEND_API_KEY=

# ─── 5. SITE CONFIGURATION ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "false" in strict production environments to disable 1-tap demo credentials
ALLOW_DEMO_LOGINS=true
